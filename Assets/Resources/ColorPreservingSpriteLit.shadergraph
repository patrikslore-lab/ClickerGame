    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CircleMask_float",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 p = WorldPos.xy;\r\nfloat d = distance(p, ZoneCenter);\r\nMask = 1.0 - smoothstep(ZoneRadius - 0.1, ZoneRadius + 0.1, d);\r\n"
}

